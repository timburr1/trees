{
  "routes": [
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/.auth/login/aad", "statusCode": 404 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/icons/*", "/api/*", "/favicon.svg", "/manifest.webmanifest", "/sw.js", "/workbox-*.js"]
  },
  "platform": { "apiRuntime": "node:22" },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  }
}
